{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u0646\u0627\u0645 \u0645\u06a9\u0627\u0644\u0645\u0647/\u06af\u0631\u0648\u0647"
    },
    "type": {
      "type": "string",
      "enum": [
        "private",
        "group",
        "class"
      ],
      "default": "private",
      "description": "\u0646\u0648\u0639 \u0645\u06a9\u0627\u0644\u0645\u0647"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0644\u06cc\u0633\u062a \u0634\u0646\u0627\u0633\u0647 \u0634\u0631\u06a9\u062a\u200c\u06a9\u0646\u0646\u062f\u06af\u0627\u0646"
    },
    "class_id": {
      "type": "string",
      "description": "\u0634\u0646\u0627\u0633\u0647 \u06a9\u0644\u0627\u0633 (\u0628\u0631\u0627\u06cc \u06af\u0631\u0648\u0647\u200c\u0647\u0627\u06cc \u06a9\u0644\u0627\u0633\u06cc)"
    },
    "last_message": {
      "type": "string",
      "description": "\u0622\u062e\u0631\u06cc\u0646 \u067e\u06cc\u0627\u0645"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0632\u0645\u0627\u0646 \u0622\u062e\u0631\u06cc\u0646 \u067e\u06cc\u0627\u0645"
    },
    "created_by": {
      "type": "string",
      "description": "\u0633\u0627\u0632\u0646\u062f\u0647 \u06af\u0631\u0648\u0647"
    }
  },
  "required": [
    "type",
    "participants"
  ]
}