{
  "name": "PublicProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u0634\u0646\u0627\u0633\u0647 \u06a9\u0627\u0631\u0628\u0631"
    },
    "full_name": {
      "type": "string",
      "description": "\u0646\u0627\u0645 \u0648 \u0646\u0627\u0645 \u062e\u0627\u0646\u0648\u0627\u062f\u06af\u06cc"
    },
    "display_name": {
      "type": "string",
      "description": "\u0646\u0627\u0645 \u0646\u0645\u0627\u06cc\u0634\u06cc"
    },
    "grade": {
      "type": "string",
      "enum": [
        "\u0647\u0641\u062a\u0645",
        "\u0647\u0634\u062a\u0645",
        "\u0646\u0647\u0645"
      ],
      "description": "\u067e\u0627\u06cc\u0647 \u062a\u062d\u0635\u06cc\u0644\u06cc"
    },
    "class_id": {
      "type": "string",
      "description": "\u0634\u0646\u0627\u0633\u0647 \u06a9\u0644\u0627\u0633"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0644\u06cc\u0633\u062a \u062f\u0631\u0648\u0633 \u0645\u0639\u0644\u0645"
    },
    "teaching_assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "grade": {
            "type": "string"
          },
          "class_id": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          }
        }
      },
      "description": "\u062a\u062e\u0635\u06cc\u0635 \u062f\u0642\u06cc\u0642 \u06a9\u0644\u0627\u0633 \u0648 \u062f\u0631\u0633 \u0628\u0631\u0627\u06cc \u0645\u0639\u0644\u0645"
    },
    "student_role": {
      "type": "string",
      "enum": [
        "teacher",
        "student",
        "admin",
        "guest"
      ],
      "description": "\u0646\u0642\u0634 \u06a9\u0627\u0631\u0628\u0631"
    },
    "avatar_color": {
      "type": "string",
      "description": "\u0631\u0646\u06af \u0622\u0648\u0627\u062a\u0627\u0631"
    },
    "active_frame": {
      "type": "string",
      "description": "\u0641\u0631\u06cc\u0645 \u0641\u0639\u0627\u0644 \u067e\u0631\u0648\u0641\u0627\u06cc\u0644"
    },
    "active_title": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0641\u0639\u0627\u0644"
    },
    "profile_image_url": {
      "type": "string",
      "description": "\u0622\u062f\u0631\u0633 \u0639\u06a9\u0633 \u067e\u0631\u0648\u0641\u0627\u06cc\u0644"
    },
    "coins": {
      "type": "number",
      "default": 0,
      "description": "\u062a\u0639\u062f\u0627\u062f \u0633\u06a9\u0647\u200c\u0647\u0627\u06cc \u0642\u0627\u0628\u0644 \u062e\u0631\u062c \u06a9\u0631\u062f\u0646"
    },
    "total_xp": {
      "type": "number",
      "default": 0,
      "description": "\u0645\u062c\u0645\u0648\u0639 \u0627\u0645\u062a\u06cc\u0627\u0632 \u062a\u062c\u0631\u0628\u0647 (\u0628\u0631\u0627\u06cc \u0645\u062d\u0627\u0633\u0628\u0647 \u0633\u0637\u062d)"
    },
    "level": {
      "type": "number",
      "default": 1,
      "description": "\u0633\u0637\u062d \u06a9\u0627\u0631\u0628\u0631"
    }
  },
  "required": [
    "user_id",
    "full_name",
    "student_role"
  ]
}