{
  "name": "StoreItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u0646\u0627\u0645 \u0622\u06cc\u062a\u0645"
    },
    "description": {
      "type": "string",
      "description": "\u062a\u0648\u0636\u06cc\u062d\u0627\u062a \u0622\u06cc\u062a\u0645"
    },
    "cost": {
      "type": "number",
      "description": "\u0642\u06cc\u0645\u062a \u0628\u0647 \u0633\u06a9\u0647"
    },
    "type": {
      "type": "string",
      "enum": [
        "profile_frame",
        "powerup"
      ],
      "description": "\u0646\u0648\u0639 \u0622\u06cc\u062a\u0645 (\u0641\u0642\u0637 \u067e\u0627\u0648\u0631\u0622\u067e \u0648 \u0641\u0631\u06cc\u0645)"
    },
    "value": {
      "type": "string",
      "description": "\u0645\u0642\u062f\u0627\u0631 \u0622\u06cc\u062a\u0645 (\u06a9\u062f \u0631\u0646\u06af\u060c \u0646\u0627\u0645 \u06a9\u0644\u0627\u0633 CSS\u060c \u06cc\u0627 JSON \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0628\u0631\u0627\u06cc \u067e\u0627\u0648\u0631-\u0622\u067e)"
    },
    "image_url": {
      "type": "string",
      "description": "\u062a\u0635\u0648\u06cc\u0631 \u067e\u06cc\u0634\u200c\u0646\u0645\u0627\u06cc\u0634"
    },
    "duration_hours": {
      "type": "number",
      "default": 0,
      "description": "\u0645\u062f\u062a \u0632\u0645\u0627\u0646 \u0627\u0639\u062a\u0628\u0627\u0631 \u067e\u0627\u0648\u0631-\u0622\u067e \u0628\u0647 \u0633\u0627\u0639\u062a"
    },
    "min_level": {
      "type": "number",
      "default": 1,
      "description": "\u062d\u062f\u0627\u0642\u0644 \u0633\u0637\u062d \u0645\u0648\u0631\u062f \u0646\u06cc\u0627\u0632 \u0628\u0631\u0627\u06cc \u062e\u0631\u06cc\u062f"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0641\u0639\u0627\u0644 \u0628\u0648\u062f\u0646 \u0622\u06cc\u062a\u0645"
    }
  },
  "required": [
    "name",
    "cost",
    "type",
    "value"
  ]
}