{
  "name": "UserInventory",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u0634\u0646\u0627\u0633\u0647 \u06a9\u0627\u0631\u0628\u0631"
    },
    "item_id": {
      "type": "string",
      "description": "\u0634\u0646\u0627\u0633\u0647 \u0622\u06cc\u062a\u0645 \u062e\u0631\u06cc\u062f\u0627\u0631\u06cc \u0634\u062f\u0647"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "avatar_color",
        "profile_frame",
        "title",
        "sticker",
        "powerup"
      ],
      "description": "\u0646\u0648\u0639 \u0622\u06cc\u062a\u0645"
    },
    "purchased_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u06cc\u062e \u062e\u0631\u06cc\u062f"
    },
    "is_active": {
      "type": "boolean",
      "default": false,
      "description": "\u0622\u06cc\u0627 \u0622\u06cc\u062a\u0645 \u0641\u0639\u0627\u0644 \u0634\u062f\u0647 \u0627\u0633\u062a\u061f (\u0628\u0631\u0627\u06cc \u067e\u0627\u0648\u0631-\u0622\u067e\u200c\u0647\u0627)"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0632\u0645\u0627\u0646 \u0641\u0639\u0627\u0644\u200c\u0633\u0627\u0632\u06cc"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0632\u0645\u0627\u0646 \u0627\u0646\u0642\u0636\u0627"
    }
  },
  "required": [
    "user_id",
    "item_id"
  ]
}