{
  "name": "LearningResource",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0645\u0646\u0628\u0639"
    },
    "description": {
      "type": "string",
      "description": "\u062a\u0648\u0636\u06cc\u062d\u0627\u062a"
    },
    "type": {
      "type": "string",
      "enum": [
        "pdf",
        "video",
        "link"
      ],
      "description": "\u0646\u0648\u0639 \u0645\u0646\u0628\u0639"
    },
    "url": {
      "type": "string",
      "description": "\u0622\u062f\u0631\u0633 \u0641\u0627\u06cc\u0644 \u06cc\u0627 \u0644\u06cc\u0646\u06a9"
    },
    "category": {
      "type": "string",
      "description": "\u062f\u0633\u062a\u0647\u200c\u0628\u0646\u062f\u06cc"
    },
    "grade": {
      "type": "string",
      "enum": [
        "\u0647\u0641\u062a\u0645",
        "\u0647\u0634\u062a\u0645",
        "\u0646\u0647\u0645"
      ],
      "description": "\u067e\u0627\u06cc\u0647 \u062a\u062d\u0635\u06cc\u0644\u06cc (\u0627\u062e\u062a\u06cc\u0627\u0631\u06cc)"
    },
    "subject": {
      "type": "string",
      "description": "\u062f\u0631\u0633 \u0645\u0631\u062a\u0628\u0637 (\u0627\u062e\u062a\u06cc\u0627\u0631\u06cc)"
    },
    "teacher_id": {
      "type": "string",
      "description": "\u0634\u0646\u0627\u0633\u0647 \u0645\u0639\u0644\u0645 \u0622\u067e\u0644\u0648\u062f \u06a9\u0646\u0646\u062f\u0647"
    },
    "view_count": {
      "type": "number",
      "default": 0,
      "description": "\u062a\u0639\u062f\u0627\u062f \u0628\u0627\u0632\u062f\u06cc\u062f"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0648\u0636\u0639\u06cc\u062a \u0641\u0639\u0627\u0644 \u0628\u0648\u062f\u0646"
    }
  },
  "required": [
    "title",
    "type",
    "url",
    "teacher_id"
  ]
}