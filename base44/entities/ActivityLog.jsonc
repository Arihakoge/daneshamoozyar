{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u0634\u0646\u0627\u0633\u0647 \u06a9\u0627\u0631\u0628\u0631"
    },
    "activity_type": {
      "type": "string",
      "enum": [
        "submission",
        "login",
        "badge_earned",
        "level_up",
        "quiz_completed"
      ],
      "description": "\u0646\u0648\u0639 \u0641\u0639\u0627\u0644\u06cc\u062a"
    },
    "points_earned": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0645\u062a\u06cc\u0627\u0632 \u06a9\u0633\u0628 \u0634\u062f\u0647"
    },
    "details": {
      "type": "string",
      "description": "\u062c\u0632\u0626\u06cc\u0627\u062a \u0641\u0639\u0627\u0644\u06cc\u062a"
    }
  },
  "required": [
    "user_id",
    "activity_type"
  ]
}