{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0637\u0644\u0627\u0639\u06cc\u0647"
    },
    "content": {
      "type": "string",
      "description": "\u0645\u062a\u0646 \u0627\u0637\u0644\u0627\u0639\u06cc\u0647"
    },
    "target_role": {
      "type": "string",
      "enum": [
        "all",
        "student",
        "teacher",
        "admin"
      ],
      "default": "all",
      "description": "\u0645\u062e\u0627\u0637\u0628\u06cc\u0646"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "description": "\u0627\u0648\u0644\u0648\u06cc\u062a"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0648\u0636\u0639\u06cc\u062a \u0641\u0639\u0627\u0644 \u0628\u0648\u062f\u0646"
    }
  },
  "required": [
