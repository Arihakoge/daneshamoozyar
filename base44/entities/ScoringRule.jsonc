{
  "name": "ScoringRule",
  "type": "object",
  "properties": {
    "teacher_id": {
      "type": "string",
      "description": "\u0634\u0646\u0627\u0633\u0647 \u0645\u0639\u0644\u0645"
    },
    "title": {
      "type": "string",
      "description": "\u0639\u0646\u0648\u0627\u0646 \u0642\u0627\u0646\u0648\u0646"
    },
    "type": {
      "type": "string",
      "enum": [
        "early_submission",
        "score_threshold",
        "perfect_score"
      ],
      "description": "\u0646\u0648\u0639 \u0642\u0627\u0646\u0648\u0646"
    },
    "value": {
      "type": "number",
      "description": "\u0645\u0642\u062f\u0627\u0631 \u0634\u0631\u0637 (\u0633\u0627\u0639\u062a \u0628\u0631\u0627\u06cc \u0627\u0631\u0633\u0627\u0644 \u0632\u0648\u062f\u062a\u0631\u060c \u062f\u0631\u0635\u062f \u0628\u0631\u0627\u06cc \u0646\u0645\u0631\u0647)"
    },
    "points": {
      "type": "number",
      "description": "\u0627\u0645\u062a\u06cc\u0627\u0632 \u067e\u0627\u062f\u0627\u0634"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0648\u0636\u0639\u06cc\u062a \u0641\u0639\u0627\u0644 \u0628\u0648\u062f\u0646"
    }
  },
  "required": [
    "teacher_id",
    "title",
    "type",
    "points"
  ]
}